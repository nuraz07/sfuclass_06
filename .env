# =============================================================================
# classroom-app · environment
# =============================================================================
# Every variable in server/src/config/env.js appears here and nothing else does.
# ops/scripts/check-env-schema.js compares the two in CI and fails on drift.
#
# Copy to .env for local development:
#   cp .env.example .env && npm run keys:generate
#
# Values marked SECRET are Secrets Manager references in staging and production
# and are never literals in a task definition. Locally they are dev throwaways
# and must never be reused anywhere real.
#
# Defaults below match docker-compose.dev.yml, so `npm run dev:infra` followed
# by `npm run dev` should need no further edits.
# =============================================================================

# --- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
PUBLIC_WS_URL=http://localhost:4000
# CORS allowlist. The Vite dev server origin; never a wildcard in production.
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,urban-doodle-qv9jjxvjw4r9c445x-5173.app.github.dev
# 0 locally, 1 behind the ALB.
TRUST_PROXY=0
RELEASE_SHA=local

# --- auth (SECRET) -----------------------------------------------------------
# base64-encoded PEM, so a key survives a single-line variable.
# Generated by `npm run keys:generate`, which writes both values into .env.
JWT_PRIVATE_
JWT_PUBLIC_
JWT_ACCESS_TTL=15m
REFRESH_TTL=30d
JWT_ISSUER=classroom-app
JWT_AUDIENCE=classroom-clients
# Minimum 16 characters. Production refuses to boot if this still starts 'dev-'.
COOKIE_SECRET=dev-cookie-secret-change-me
COOKIE_DOMAIN=
COOKIE_SECURE=true

# --- database ----------------------------------------------------------------
DATABASE_URL=postgres://classroom:classroom@localhost:5432/classroom
# Empty means "use the primary for reads too". A read replica only exists in prod.
DATABASE_READ_URL=
# 'require' or 'verify-full' in production; TLS to the database is mandatory there.
PGSSLMODE=disable
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=15000
PG_CONNECTION_TIMEOUT_MS=5000

# --- redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_TLS=false
REDIS_PREFIX=classroom

# --- storage -----------------------------------------------------------------
AWS_REGION=eu-central-1
S3_BUCKET_RAW=classroom-dev-raw
S3_BUCKET_QUARANTINE=classroom-dev-quarantine
S3_BUCKET_DELIVERY=classroom-dev-delivery
# MinIO only. Production refuses to boot with this set.
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=classroom-dev
AWS_SECRET_ACCESS_KEY=classroom-dev-secret
# Locally this is MinIO itself; in AWS it is the CloudFront delivery domain.
CDN_DOMAIN=localhost:9000
CDN_KEY_PAIR_ID=
# SECRET. Signs delivery URLs. Required in production.
CDN_PRIVATE_KEY=
CDN_SIGNED_URL_TTL_SEC=300
MAX_UPLOAD_MB=2048
MEDIACONVERT_ROLE_ARN=
MEDIACONVERT_ENDPOINT=
MEDIACONVERT_QUEUE_ARN=
# 'clamav' needs `npm run dev:infra:full`; 'disabled' skips the quarantine gate.
ANTIVIRUS_MODE=disabled
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- sfu ---------------------------------------------------------------------
SFU_HTTP_PORT=4200
SFU_NODE_ID=sfu-local-1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40001
# What the browser is told to send media to. 127.0.0.1 works only when the
# browser is on this machine; set the LAN IP to test across devices. Production
# resolves it from instance metadata and refuses to boot on 127.0.0.1.
ANNOUNCED_IP=127.0.0.1
# 0 means one worker per CPU core.
MEDIASOUP_WORKERS=0
SFU_MAX_ROOMS_PER_NODE=40
SFU_DRAIN_TIMEOUT_SEC=1800
TURN_URL=
TURN_SECRET=
TURN_CREDENTIAL_TTL_SEC=86400
SCREENSHARE_MAX_PRESENTERS=1
SCREENSHARE_MAX_BITRATE_KBPS=2500
# Low on purpose: fifteen frames of readable text beat thirty of mush.
SCREENSHARE_MAX_FRAMERATE=15
RECORDING_ENABLED=false
RECORDING_RETENTION_DAYS=90

# --- realtime ----------------------------------------------------------------
REALTIME_PORT=4100
SOCKET_PING_INTERVAL_MS=25000
# Must stay below twice the ping interval, or env.js rejects it.
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_MAX_EVENTS_PER_MIN=240
PRESENCE_TTL_SEC=60

# --- messaging ---------------------------------------------------------------
CHAT_MAX_MESSAGE_LEN=4000
CHAT_RATE_PER_MIN=30
# Cannot exceed MAX_UPLOAD_MB.
CHAT_ATTACHMENT_MAX_MB=100
# 0 disables pruning; anything else drives the retention job and the S3 rule.
CHAT_RETENTION_DAYS=0
CHAT_SLOW_MODE_SEC=0
CHAT_EDIT_WINDOW_MIN=15
CHAT_DEFAULT_DM_POLICY=shared-context

# --- notifications -----------------------------------------------------------
# 'smtp' points at Mailpit locally; 'ses' is production.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SES_FROM=noreply@classroom.local
SES_REGION=eu-central-1
SNS_PLATFORM_APP_APNS=
SNS_PLATFORM_APP_FCM=
NOTIFY_PUSH_DELAY_MIN=2
DIGEST_SEND_HOUR_UTC=6

# --- billing -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MAP={}
BILLING_ENTITLEMENT_TTL_SEC=60

# --- search ------------------------------------------------------------------
# Needs `npm run dev:infra:full`. Leave disabled unless you are working on F2/F6 search.
OPENSEARCH_URL=
OPENSEARCH_INDEX_PREFIX=classroom
SEARCH_ENABLED=false

# --- background work ---------------------------------------------------------
WORKER_CONCURRENCY=5
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_MS=5000
QUEUE_KEEP_COMPLETED=1000
QUEUE_KEEP_FAILED=5000

# --- observability -----------------------------------------------------------
LOG_LEVEL=debug
# Production logs must be JSON; env.js rejects true there.
LOG_PRETTY=true
SERVICE_NAME=classroom-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_ARG=1
METRICS_ENABLED=true

# --- limits and hardening ----------------------------------------------------
BODY_LIMIT_KB=256
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_PER_IP=300
RATE_LIMIT_MAX_PER_USER=600
SHUTDOWN_GRACE_SEC=25
READINESS_TIMEOUT_MS=2000