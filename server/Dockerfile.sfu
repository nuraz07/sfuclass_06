# server/Dockerfile.sfu [NEW] mediasoup build deps only (F1,F7)
# mediasoup-worker is a native binary compiled at npm-install time (needs
# python3, make, g++, plus libssl headers). None of that toolchain belongs
# in the image that actually runs on the SFU EC2 hosts - it's discarded
# after the builder stage.

# ---- builder: compile mediasoup's native worker ----
FROM node:22-bookworm-slim AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-pip make g++ pkg-config libssl-dev ninja-build \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
COPY server/package.json server/package.json
RUN npm ci --workspace=server --omit=dev

COPY server/ server/

# ---- runtime: no compiler, no headers - just the compiled worker + node_modules ----
FROM node:22-bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends dumb-init libssl3 curl \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    MEDIASOUP_MIN_PORT=40000 \
    MEDIASOUP_MAX_PORT=40100

WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/server/node_modules ./server/node_modules
COPY --from=builder /app/server ./server

# mediasoup needs a real (non-root) but stable uid so the EC2 host's
# ECS_ENABLE_TASK_ENI=false / host-network setup doesn't fight over ports.
USER node

# 40000-40100/udp is the RTP/RTCP range; 443/tcp is the TURN-over-TCP
# fallback listener - both bound directly to the EC2 host (network_mode=host
# in ecs-sfu.tf), not published here.
EXPOSE 40000-40100/udp
EXPOSE 443/tcp

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsk "https://localhost:443/healthz/sfu" || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server/src/mediasoup/WorkerManager.js"]