# turn/config/turnserver.conf.tmpl
#
# coturn configuration of one TURN node. Rendered at container start by bootstrap/render-config.sh into
# /run/turn/turnserver.conf (tmpfs, mode 0600). Every placeholder is replaced; entrypoint.sh refuses to
# start coturn if a placeholder is left or a required directive is missing. One directive per line.
#
# Relation to the rest of the platform:
#   - clients receive this node's hostname and temporary credentials from the API (server/src/rtc/);
#     credentials are base64(HMAC-SHA1(secret, "<expiry>:<opaqueId>")) — the TURN REST API scheme (use-auth-secret);
#   - the SFU never talks to this server; relayed packets simply arrive at the SFU from this node's Elastic IP;
#   - the agent sidecar (turn/agent) reads allocations from the Prometheus endpoint and heartbeats this node
#     into the TURN registry.
#
# Owner: F8 Real-Time Connectivity.

# ---------------------------------------------------------------- identity
realm=${TURN_REALM}
server-name=${TURN_NODE_NAME}
no-software-attribute

# ---------------------------------------------------------------- addressing
# Host networking: listen on the private IP; AWS maps the Elastic IP 1:1 onto it. external-ip makes coturn
# announce the Elastic IP in XOR-RELAYED-ADDRESS and XOR-MAPPED-ADDRESS.
listening-ip=${TURN_PRIVATE_IP}
relay-ip=${TURN_PRIVATE_IP}
external-ip=${TURN_PUBLIC_IP}/${TURN_PRIVATE_IP}

# ---------------------------------------------------------------- ports
# 3478 UDP+TCP: STUN and TURN. 443 TCP: TURN over TLS for networks that only allow HTTPS-like traffic.
listening-port=${TURN_LISTEN_PORT}
tls-listening-port=${TURN_TLS_PORT}
# No RFC 5780 alternate ports and no DTLS listener: only the published ports exist.
no-rfc5780
no-dtls
no-stun-backward-compatibility
# Relay ports: reachable only from the SFU prefix list (security group).
min-port=${TURN_RELAY_MIN_PORT}
max-port=${TURN_RELAY_MAX_PORT}

# ---------------------------------------------------------------- authentication (TURN REST API)
use-auth-secret
# Accepted secrets, one static-auth-secret line each: AWSCURRENT, AWSPENDING (rotation phase 1),
# AWSPREVIOUS (until rotation phase 3). The API signs with AWSCURRENT only.
${TURN_STATIC_AUTH_SECRETS}
rest-api-separator=:
stale-nonce=600
fingerprint

# ---------------------------------------------------------------- TLS (TURN over TLS on 443)
cert=${TURN_TLS_DIR}/fullchain.pem
pkey=${TURN_TLS_DIR}/privkey.pem
no-tlsv1
no-tlsv1_1
# TLS 1.2 limited to forward-secret AEAD suites; TLS 1.3 suites are OpenSSL defaults (all AEAD).
cipher-list=ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305

# ---------------------------------------------------------------- relay policy
# The relay leg to the SFU is always UDP: no RFC 6062 TCP allocations.
no-tcp-relay
no-multicast-peers
# Blocked peers (turn/config/denied-peers.conf):
${TURN_DENIED_PEERS}

# ---------------------------------------------------------------- quotas
# Per credential (one device session): send + receive transports with ICE restarts and a backup node.
user-quota=${TURN_USER_QUOTA}
# Per node: sized so relayed bandwidth, not allocation count, is the binding limit.
total-quota=${TURN_TOTAL_QUOTA}
# Per allocation, bytes per second (0 = unlimited).
max-bps=${TURN_MAX_BPS}
# Whole node, bytes per second; new allocations are refused above it (0 = unlimited).
bps-capacity=${TURN_BPS_CAPACITY}
max-allocate-lifetime=3600

# ---------------------------------------------------------------- operations
no-cli
prometheus
prometheus-port=${TURN_PROMETHEUS_PORT}
pidfile=${TURN_RUNTIME_DIR}/turnserver.pid
userdb=${TURN_RUNTIME_DIR}/turndb
log-file=stdout
simple-log